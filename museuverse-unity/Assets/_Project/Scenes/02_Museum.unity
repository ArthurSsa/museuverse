      value: 
      objectReference: {fileID: 2100000, guid: 192770e9bc5ccb14ea27ca951d32faa2, type: 2}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: title
      value: Luzia
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: narration
      value: 
      objectReference: {fileID: 8300000, guid: 9c412a0f8f2ff014f845398510926f16, type: 3}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: artifactId
      value: luzia
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: longDescription
      value: "Luzia \xE9 o nome dado ao cr\xE2nio f\xF3ssil de uma mulher que viveu
        h\xE1 aproximadamente 11.500 anos, descoberto em 1975 na regi\xE3o de Lagoa
        Santa, Minas Gerais. Considerado por d\xE9cadas o esqueleto humano mais antigo
        das Am\xE9ricas, Luzia se tornou um s\xEDmbolo da pr\xE9-hist\xF3ria brasileira
        e um marco para a paleoantropologia mundial. Suas caracter\xEDsticas morfol\xF3gicas
        reacenderam debates sobre as rotas de povoamento do continente americano.
        Em setembro de 2018, o inc\xEAndio que devastou o Museu Nacional do Rio de
        Janeiro consumiu grande parte do laborat\xF3rio onde Luzia era guardada.
        Pesquisadores conseguiram recuperar fragmentos do cr\xE2nio em meio aos escombros,
        num esfor\xE7o heroico de preserva\xE7\xE3o. Luzia n\xE3o \xE9 apenas um
        f\xF3ssil \u2014 \xE9 a mem\xF3ria mais antiga das Am\xE9ricas, e sua perda
        parcial representa uma ferida coletiva na hist\xF3ria da ci\xEAncia brasileira."
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: shortDescription
      value: "O f\xF3ssil humano mais antigo das Am\xE9ricas, com cerca de 11.500
        anos."
      objectReference: {fileID: 0}
