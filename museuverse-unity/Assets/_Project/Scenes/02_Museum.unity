      value: Pec_Adandozan
      objectReference: {fileID: 0}
    - target: {fileID: 4638265166684643419, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: 2a443aaaaf62bfa479075601033ce517, type: 2}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: title
      value: Trono de Adandozan
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: narration
      value: 
      objectReference: {fileID: 8300000, guid: 5b9d24f1d6cca78438ce31ab4bbff341, type: 3}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: artifactId
      value: adandozan
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: longDescription
      value: "O trono pertenceu ao rei Adandozan, soberano do Reino do Daom\xE9 \u2014
        atual Benim, na \xC1frica Ocidental \u2014 entre 1797 e 1818. A pe\xE7a foi
        enviada como presente diplom\xE1tico ao pr\xEDncipe regente Dom Jo\xE3o VI
        do Brasil, no in\xEDcio do s\xE9culo XIX, como gesto de alian\xE7a e respeito
        entre reinos. Esculpido em madeira e adornado com elementos simb\xF3licos
        da realeza africana, o trono representa uma das mais importantes conex\xF5es
        materiais entre o Brasil e o continente africano antes mesmo da aboli\xE7\xE3o
        da escravatura. Para a di\xE1spora africana brasileira, a pe\xE7a era um
        testemunho concreto de soberania, riqueza e civiliza\xE7\xE3o dos reinos
        da \xC1frica pr\xE9-colonial \u2014 uma narrativa frequentemente apagada
        pela historiografia oficial. Sua destrui\xE7\xE3o no inc\xEAndio de 2018
        representa n\xE3o apenas a perda de um objeto, mas o silenciamento de uma
        hist\xF3ria que precisa continuar sendo contada.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: shortDescription
      value: "Trono real do Reino do Daom\xE9, presente diplom\xE1tico do s\xE9c.
        XIX.  "
      objectReference: {fileID: 0}
