    - target: {fileID: 2847730122776185216, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: m_Name
      value: Pec_ShaAmun
      objectReference: {fileID: 0}
    - target: {fileID: 4638265166684643419, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: a6d9068c418d6594faceb39967df4ceb, type: 2}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: title
      value: "Sarc\xF3fago de Sha-Amun-em-su"
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: narration
      value: 
      objectReference: {fileID: 8300000, guid: 3dc88380a525cc14a89fb1c74e29e702, type: 3}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: artifactId
      value: shaamun
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: longDescription
      value: "Sha-Amun-em-su foi uma sacerdotisa cantora do templo de Amon, em Karnak,
        no Antigo Egito, que viveu por volta do s\xE9culo VIII a.C. \u2014 h\xE1
        aproximadamente 2.800 anos. Seu sarc\xF3fago, feito em madeira ricamente
        decorada com hier\xF3glifos e cenas religiosas, foi doado ao imperador Dom
        Pedro II em 1876, durante uma de suas viagens ao Egito. O sarc\xF3fago era
        considerado um dos itens mais preciosos do acervo egiptol\xF3gico do Museu
        Nacional, sendo um raro caso de sarc\xF3fago n\xE3o aberto: a m\xFAmia continuava
        lacrada em seu interior, intocada por mais de 2.800 anos. Os hier\xF3glifos
        da pe\xE7a preservavam ora\xE7\xF5es funer\xE1rias e o nome da sacerdotisa,
        garantindo, segundo a cren\xE7a eg\xEDpcia, sua vida eterna. O inc\xEAndio
        de 2018 consumiu o sarc\xF3fago e a m\xFAmia que permanecia lacrada em seu
        interior, intocada por quase 2.800 anos. Em uma \xFAnica noite, as chamas
        apagaram o que o tempo havia preservado por quase tr\xEAs mil\xEAnios \u2014
        e, se os hier\xF3glifos da pe\xE7a prometiam \xE0 sacerdotisa a vida eterna,
        foi o fogo que interrompeu essa promessa, levando consigo um dos elos mais
        antigos entre o Brasil e a Antiguidade."
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: shortDescription
      value: "Sarc\xF3fago eg\xEDpcio do s\xE9culo VIII a.C., tesouro do acervo egiptol\xF3gico
        do Brasil.  "
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 734d904bc7622c443b4392116837647d, type: 3}
