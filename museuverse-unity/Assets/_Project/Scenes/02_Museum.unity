    - target: {fileID: 2847730122776185216, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: m_Name
      value: Pec_Bendego
      objectReference: {fileID: 0}
    - target: {fileID: 4638265166684643419, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: m_Materials.Array.data[0]
      value: 
      objectReference: {fileID: 2100000, guid: 87dbb2d65cae58f489553e08002963d9, type: 2}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: title
      value: "Meteorito de Bendeg\xF3"
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: narration
      value: 
      objectReference: {fileID: 8300000, guid: 24b5be66e5b25854d9df07e5bfc9c5ff, type: 3}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: artifactId
      value: bendego
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: longDescription
      value: "Encontrado em 1784 na regi\xE3o do Bendeg\xF3, no sert\xE3o da Bahia,
        este meteorito de cerca de 5,3 toneladas \xE9 um dos maiores j\xE1 registrados
        no Brasil e o segundo maior meteorito ferroso j\xE1 encontrado em territ\xF3rio
        brasileiro. Sua viagem at\xE9 o Museu Nacional, no s\xE9culo XIX, foi \xE9pica:
        foram quase 130 quil\xF4metros percorridos em uma carro\xE7a de boi adaptada,
        num feito de engenharia da \xE9poca. Por mais de um s\xE9culo, o Bendeg\xF3
        foi um dos itens mais admirados do acervo, recebendo gera\xE7\xF5es de visitantes
        fascinados por sua origem c\xF3smica. Quando o inc\xEAndio de 2018 destruiu
        o museu, o meteorito foi um dos poucos itens que sobreviveu praticamente
        intacto \xE0s chamas \u2014 gra\xE7as \xE0 sua composi\xE7\xE3o de ferro
        e n\xEDquel. Hoje, o Bendeg\xF3 \xE9 s\xEDmbolo de resist\xEAncia: uma rocha
        que atravessou o espa\xE7o, sobreviveu a uma viagem improv\xE1vel e resistiu
        at\xE9 mesmo ao fogo que apagou tantas outras mem\xF3rias.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5893591189420491564, guid: 734d904bc7622c443b4392116837647d, type: 3}
      propertyPath: shortDescription
      value: "Um dos maiores meteoritos j\xE1 encontrados no Brasil, sobrevivente
        do inc\xEAndio de 2018. "
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 734d904bc7622c443b4392116837647d, type: 3}
